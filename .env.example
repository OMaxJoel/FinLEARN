# ============================================================================
# FINEXPERT IMMERSION 360° - VARIABLES D'ENVIRONNEMENT D'EXEMPLE
# ============================================================================

# ----------------------------------------------------------------------------
# 1. BASE DE DONNÉES RELATIONNELLE PERSISTANTE (PostgreSQL)
# Recommandé : Neon (neon.tech) ou Supabase (supabase.com) - Offres gratuites avec quota adapté
# Format : postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:votre_mot_de_passe_ici@ep-sample-pool-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Configuration optionnelle pour connexion directe de migration
DIRECT_URL=postgresql://neondb_owner:votre_mot_de_passe_ici@ep-sample-pool-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ----------------------------------------------------------------------------
# 2. CONFIGURATION DE L'ENVIRONNEMENT VERCEL
# Valeurs autorisées : 'development', 'preview', 'production'
# ----------------------------------------------------------------------------
VERCEL_ENV=production
NODE_ENV=production

# ----------------------------------------------------------------------------
# 3. SÉCURITÉ ET SESSIONS UTILISATEUR
# Clé secrète pour la signature de jetons ou sessions sécurisées côté serveur
# ----------------------------------------------------------------------------
JWT_SECRET=generer_cle_secrete_aleatoire_64_caracteres_min_pour_prod

# ----------------------------------------------------------------------------
# 4. VARIABLES PUBLIQUES (ACCESSIBLES CÔTÉ NAVIGATEUR AVEC PRÉFIXE VITE_)
# ATTENTION : Ne JAMAIS insérer de mot de passe ou secret dans ces variables !
# ----------------------------------------------------------------------------
VITE_APP_NAME="FinExpert Immersion"
VITE_APP_VERSION="2.4.0"
VITE_ENABLE_OFFLINE_SYNC=true
VITE_API_BASE_URL=""
